<Bindings>
    <!-- `category` is the top-level section name in Escape > Options > Keybindings.
         A literal string here gives Eyes Up its own collapsible section instead of
         being buried under the generic "AddOns" list (this is how Better Fishing,
         Details! and friends get their own header). The binding labels come from
         the BINDING_NAME_* globals set in Core.lua. -->
    <Binding name="EYESUP_TOGGLE_HUD" category="Eyes Up Add On">
        EyesUpToggleHUD()
    </Binding>
    <Binding name="EYESUP_TOGGLE_CUE" category="Eyes Up Add On">
        EyesUpToggleEnabled()
    </Binding>
</Bindings>
